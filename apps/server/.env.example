# API runtime
NODE_ENV=development
APP_HOST=0.0.0.0
PORT=3000

# PostgreSQL connection contract. When the API runs directly on the host,
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subscription_track
DB_USER=subscription_track
DB_PASSWORD=change-me

# Authentication contract
# Production JWT secrets must be generated using a CSPRNG with >= 256 bits of entropy (minimum 32 characters)
JWT_SECRET=replace-with-a-cryptographically-random-secret

# Observability: internal Prometheus endpoint (api and worker)
# Served on its own HTTP server, bound inside the container only. It is never
# published to the host and nginx proxies nothing to it, so GET /metrics on the
# API port is a plain 404.
# 0 asks the OS for a free ephemeral port. That is for tests only: with
# NODE_ENV=production the api and the worker both refuse to start on 0,
# because the port would change on every restart and nothing could scrape it.
# The api and the worker both default to 9464. Running both on one host without
# containers makes the second process fail to bind (it logs the failure and
# keeps serving); give one of them a different port in that case.
METRICS_PORT=9464

# API only. Rolling window in seconds for the `active_users` gauge (1..86400).
# Counted in process memory, so the value is per process and resets on restart.
ACTIVE_USERS_WINDOW_SECONDS=900

# Worker runtime only (src/worker.ts). The API does not read these.
REDIS_HOST=localhost
REDIS_PORT=6379

# Worker push provider: 'stub' for local development/automated tests (no
# credentials required, never contacts a real push service), or 'fcm' for
# real delivery via Firebase Cloud Messaging.
PUSH_PROVIDER=stub

# Required only when PUSH_PROVIDER=fcm. Full Firebase service-account JSON as
# a single-line string. Never commit real credentials here.
FCM_SERVICE_ACCOUNT_JSON=
