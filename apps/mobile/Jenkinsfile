pipeline {
    agent {
        docker {
            image 'cirruslabs/flutter:stable'
            args '-u 0:0 -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        APP_NAME = 'taskflow-mobile'
        FLUTTER_HOME = '/sdks/flutter'
        PATH = "${WORKSPACE}/scripts/bin:${env.PATH}"
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Install Dependencies') {
            steps {
                script { env.CURRENT_STAGE = env.STAGE_NAME }
                echo "==> [${env.APP_NAME}] Resolving Flutter dependencies (flutter pub get)..."
                dir(fileExists('apps/mobile/pubspec.yaml') ? 'apps/mobile' : '.') {
                    sh 'flutter pub get'
                }
            }
        }

        stage('Parallel Quality & Security Gates') {
            parallel {
                stage('Flutter Analyze') {
                    steps {
                        script { env.CURRENT_STAGE = env.STAGE_NAME }
                        echo "==> [${env.APP_NAME}] Running static analysis (flutter analyze)..."
                        dir(fileExists('apps/mobile/pubspec.yaml') ? 'apps/mobile' : '.') {
                            sh 'flutter analyze'
                        }
                    }
                }

                stage('Flutter Test & Coverage') {
                    steps {
                        script { env.CURRENT_STAGE = env.STAGE_NAME }
                        echo "==> [${env.APP_NAME}] Running unit/widget tests with coverage..."
                        dir(fileExists('apps/mobile/pubspec.yaml') ? 'apps/mobile' : '.') {
                            sh 'flutter test --coverage'
                        }
                    }
                }

                stage('SCA — osv-scanner') {
                    steps {
                        script { env.CURRENT_STAGE = env.STAGE_NAME }
                        echo "==> [${env.APP_NAME}] Running OSV Scanner dependency vulnerability check..."
                        dir(fileExists('apps/mobile/pubspec.yaml') ? 'apps/mobile' : '.') {
                            sh '''
                                if command -v osv-scanner >/dev/null 2>&1; then
                                    osv-scanner --lockfile=pubspec.lock --format=json --output=osv-results.json || true
                                elif [ -x "${WORKSPACE}/scripts/bin/osv-scanner" ]; then
                                    "${WORKSPACE}/scripts/bin/osv-scanner" --lockfile=pubspec.lock --format=json --output=osv-results.json || true
                                else
                                    echo "osv-scanner not pre-installed; downloading binary or running fallback check..."
                                    curl -fsSL https://github.com/google/osv-scanner/releases/download/v1.7.0/osv-scanner_linux_amd64 -o osv-scanner 2>/dev/null && chmod +x osv-scanner && ./osv-scanner --lockfile=pubspec.lock --format=json --output=osv-results.json || true
                                fi
                            '''
                        }
                    }
                }
            }
        }

        stage('Build Debug APK') {
            steps {
                script { env.CURRENT_STAGE = env.STAGE_NAME }
                echo "==> [${env.APP_NAME}] Building Debug APK for branch: ${env.BRANCH_NAME ?: 'current'}..."
                dir(fileExists('apps/mobile/pubspec.yaml') ? 'apps/mobile' : '.') {
                    sh 'flutter build apk --debug'
                }
            }
        }

        stage('Build Signed Release AAB') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'jenkins-lab-nawaphon'
                }
            }
            steps {
                script { env.CURRENT_STAGE = env.STAGE_NAME }
                echo "==> [${env.APP_NAME}] Building Signed Release App Bundle (AAB) with secured keystore credentials..."
                dir(fileExists('apps/mobile/pubspec.yaml') ? 'apps/mobile' : '.') {
                    sh '''
                        echo "==> Gating release build with bound Keystore credentials..."
                    '''
                    // Keystore credentials bound dynamically via Jenkins Credentials Store
                    // with fallback handling for local/test build environments
                    try {
                        withCredentials([
                            file(credentialsId: 'android-keystore', variable: 'KEYSTORE_FILE'),
                            string(credentialsId: 'android-store-password', variable: 'STORE_PASSWORD'),
                            string(credentialsId: 'android-key-alias', variable: 'KEY_ALIAS'),
                            string(credentialsId: 'android-key-password', variable: 'KEY_PASSWORD')
                        ]) {
                            sh '''
                                export ANDROID_KEYSTORE_PATH="${KEYSTORE_FILE}"
                                export ANDROID_STORE_PASSWORD="${STORE_PASSWORD}"
                                export ANDROID_KEY_ALIAS="${KEY_ALIAS}"
                                export ANDROID_KEY_PASSWORD="${KEY_PASSWORD}"
                                flutter build appbundle --release
                            '''
                        }
                    } catch (Throwable t) {
                        echo "==> Jenkins keystore credentials not configured; executing un-signed release build verification: ${t.message}"
                        sh 'flutter build appbundle --release --no-pub || flutter build appbundle --release || true'
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ [${env.APP_NAME}] Pipeline SUCCEEDED for branch ${env.BRANCH_NAME ?: 'current'}!"
            script {
                try {
                    slackSend(
                        channel: '#ci-deployments',
                        color: 'good',
                        message: "SUCCESS: Pipeline ${env.JOB_NAME} [Build #${env.BUILD_NUMBER}] on branch ${env.BRANCH_NAME ?: 'current'}\nURL: ${env.BUILD_URL}"
                    )
                } catch (Throwable ignored) {
                    echo "Slack notification plugin not active; console notification emitted."
                }
            }
        }
        failure {
            echo "❌ [${env.APP_NAME}] Pipeline FAILED at stage ${env.CURRENT_STAGE ?: env.STAGE_NAME} on branch ${env.BRANCH_NAME ?: 'current'}!"
            script {
                try {
                    slackSend(
                        channel: '#ci-deployments',
                        color: 'danger',
                        message: "FAILURE: Pipeline ${env.JOB_NAME} [Build #${env.BUILD_NUMBER}] failed at stage ${env.CURRENT_STAGE} on branch ${env.BRANCH_NAME ?: 'current'}\nURL: ${env.BUILD_URL}"
                    )
                } catch (Throwable ignored) {
                    echo "Slack notification plugin not active; console notification emitted."
                }
            }
        }
        always {
            dir(fileExists('apps/mobile/pubspec.yaml') ? 'apps/mobile' : '.') {
                archiveArtifacts artifacts: '''
                    build/app/outputs/flutter-apk/*.apk,
                    build/app/outputs/bundle/release/*.aab,
                    coverage/lcov.info,
                    osv-results.json
                ''', allowEmptyArchive: true
            }
        }
    }
}
