# ==============================================================================
# Jinja2 Template: Kubernetes Secrets Rendered from Ansible Vault
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  labels:
    app: postgres
type: Opaque
stringData:
  POSTGRES_DB: "{{ vault_postgres_db }}"
  POSTGRES_USER: "{{ vault_postgres_user }}"
  POSTGRES_PASSWORD: "{{ vault_postgres_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  labels:
    app: taskflow
type: Opaque
stringData:
  JWT_SECRET: "{{ vault_jwt_secret }}"
  DB_PASSWORD: "{{ vault_postgres_password }}"
  DATABASE_URL: "postgresql://{{ vault_postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ vault_postgres_db }}?schema=public"
  {% if vault_redis_password %}
  REDIS_PASSWORD: "{{ vault_redis_password }}"
  {% endif %}
---
apiVersion: v1
kind: Secret
metadata:
  name: backup-s3-secret
  labels:
    app: postgres-backup
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "{{ vault_s3_backup_access_key }}"
  AWS_SECRET_ACCESS_KEY: "{{ vault_s3_backup_secret_key }}"
  S3_BACKUP_BUCKET: "{{ vault_s3_backup_bucket }}"
  AWS_DEFAULT_REGION: "{{ vault_s3_backup_region }}"
  {% if vault_s3_backup_endpoint %}
  AWS_ENDPOINT_URL: "{{ vault_s3_backup_endpoint }}"
  {% endif %}
