# ==============================================================================
# Subscription Track — Server Environment Configuration Schema (.env.example)
# ==============================================================================
# Copy this file to .env before starting local services:
#   cp .env.example .env
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_HOST=0.0.0.0
PORT=3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# When API runs directly on host: DB_HOST=localhost
# Inside Docker Compose network:   DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subSDB
DB_USER=admin
DB_PASSWORD=zwlHe3ewdHk0hyJs
# Optional full connection URL (derived automatically if omitted, required by Prisma):
DATABASE_URL="postgresql://admin:zwlHe3ewdHk0hyJs@localhost:5432/subSDB?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Production JWT secrets must be generated using a CSPRNG with >= 256 bits of entropy (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=dev-only-local-secret-not-for-production-min-32-chars-long

# ------------------------------------------------------------------------------
# 4. Third-Party Integrations & OAuth
# ------------------------------------------------------------------------------
# Google OAuth Client ID (must match apps/mobile/lib/core/network/api_config.dart)
GOOGLE_CLIENT_ID=599940750728-bh01euq9q5unhnvlnai02sjlj18km8tm.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Redis Cache & Queue Connection
# ------------------------------------------------------------------------------
# When API runs on host: REDIS_HOST=localhost
# Inside Docker Compose: REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Worker & Notification Service
# ------------------------------------------------------------------------------
# 'stub' for local development/automated tests (no credentials required),
# or 'fcm' for real delivery via Firebase Cloud Messaging.
PUSH_PROVIDER=stub

# Required only when PUSH_PROVIDER=fcm. Full Firebase service-account JSON as
# a single-line string. Never commit real credentials here.
FCM_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 7. Observability & Metrics
# ------------------------------------------------------------------------------
# Internal Prometheus endpoint (api and worker default to 9464)
METRICS_PORT=9464

# Rolling window in seconds for the active_users gauge (1..86400)
ACTIVE_USERS_WINDOW_SECONDS=900

# Maintenance mode toggle ('true' or 'false')
MAINTENANCE_MODE=false

# Error tracking (DP-503, optional). Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=

# ------------------------------------------------------------------------------
# 8. Agent & Governance Configuration
# ------------------------------------------------------------------------------
AGENT_RULES_FILE=agent.md

