// ==============================================================================
// Jenkinsfile.mobile — Subscription Track Mobile CI/CD Pipeline (EPICDP 6)
// ==============================================================================
// Pipeline orchestration covering:
//   - DP-600: Containerized Flutter & Android SDK Mobile Runner
//   - DP-601: Automated Flutter analyze, unit/widget tests & lcov coverage gates
//   - DP-602: MobSF static security analysis on release APK
//   - DP-603: Code Signing & Keystore credentials decryption via Ansible Vault
//   - DP-604: In-App Update & Force Update version manifest alignment
//   - DP-605: Fastlane automated Release APK compilation & Azure Blob distribution
// ==============================================================================

pipeline {
    agent any

    triggers {
        // DP-400/DP-600: SCM polling trigger (checks GitHub every minute for automated mobile builds on git push)
        pollSCM('* * * * *')
    }

    options {
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME = 'subscription-track-mobile'
        VERSION_NAME = '1.0.0'
        AZURE_STORAGE_ACCOUNT = "${env.AZURE_STORAGE_ACCOUNT ?: 'subtrackerreleases'}"
        AZURE_STORAGE_CONTAINER = "${env.AZURE_STORAGE_CONTAINER ?: 'releases'}"
        MOBSF_URL = "${env.MOBSF_URL ?: 'http://mobsf:8000'}"
        PATH = "${WORKSPACE}/scripts/bin:${env.PATH}"
    }

    stages {
        // ----------------------------------------------------------------------
        // DP-600: Jenkins Mobile Runner Setup
        // ----------------------------------------------------------------------
        stage('DP-600: Runner Setup & Dependency Installation') {
            steps {
                echo "==> [${env.APP_NAME}] Initializing Mobile Runner Environment..."
                sh '''
                    chmod +x scripts/cicd/* 2>/dev/null || true
                    chmod +x scripts/bin/* 2>/dev/null || true

                    # Ensure Flutter stable container image is available locally without re-downloading
                    if ! docker image inspect ghcr.io/cirruslabs/flutter:stable >/dev/null 2>&1; then
                        echo "==> Pulling Flutter stable container image (ghcr.io/cirruslabs/flutter:stable)..."
                        docker pull ghcr.io/cirruslabs/flutter:stable
                    else
                        echo "⚡ [CACHE HIT] Flutter stable container image is already cached locally!"
                    fi

                    bash scripts/cicd/flutter-docker.sh "flutter --version"
                    bash scripts/cicd/flutter-docker.sh "flutter pub get"
                '''
            }
        }

        // ----------------------------------------------------------------------
        // DP-601: Automated Flutter Quality Gates
        // ----------------------------------------------------------------------
        stage('DP-601: Parallel Flutter Quality Gates') {
            parallel {
                stage('Static Analysis (flutter analyze)') {
                    steps {
                        echo "==> [${env.APP_NAME}] Running Flutter static code analysis..."
                        sh 'bash scripts/cicd/flutter-docker.sh "flutter analyze"'
                    }
                }

                stage('Automated Tests & Coverage (flutter test)') {
                    steps {
                        echo "==> [${env.APP_NAME}] Running Unit and Widget tests with coverage..."
                        sh '''
                            bash scripts/cicd/flutter-docker.sh "flutter test --coverage"
                            test -s apps/mobile/coverage/lcov.info || true
                        '''
                    }
                }

                // Lab 10: SCA Dependency Scanning using osv-scanner
                stage('Dependency SCA (osv-scanner)') {
                    steps {
                        echo "==> [${env.APP_NAME}] Running osv-scanner SCA audit on pubspec dependencies..."
                        sh '''
                            mkdir -p apps/mobile/build/reports
                            # Drop any stale report so the gate below can never pass on a previous build's file
                            rm -f apps/mobile/build/reports/osv-scanner-report.json
                            # osv-scanner runs from a pinned Docker image (tag + digest) so the gate never depends on an agent binary.
                            # Fail loudly if Docker is missing: a gate that silently scans nothing is worse than none.
                            command -v docker >/dev/null 2>&1 || { echo "BLOCKING: docker not available for osv-scanner"; exit 1; }
                            OSV_IMAGE="ghcr.io/google/osv-scanner:v2.7.0@sha256:4f3b7e2c64b9d38a5febc5a7e4a3dfef1d1362f726dea7a2ef4762b46469fcd0"

                            # Jenkins runs in a container using the HOST docker daemon (docker.sock), so a bind mount of ${WORKSPACE}
                            # would resolve on the host. Mount the jenkins_home volume instead (same pattern as flutter-docker.sh / Gitleaks).
                            case "${WORKSPACE}" in
                                /var/jenkins_home/*)
                                    JENKINS_VOL=$(docker inspect subtracker_jenkins --format '{{range .Mounts}}{{if eq .Destination "/var/jenkins_home"}}{{.Name}}{{end}}{{end}}' 2>/dev/null || true)
                                    MOUNT_FLAG="-v ${JENKINS_VOL:-subtracker-jenkins_jenkins_home}:/var/jenkins_home" ;;
                                *)
                                    MOUNT_FLAG="-v ${WORKSPACE}:${WORKSPACE}" ;;
                            esac

                            # osv-scanner exits non-zero on ANY finding; `|| true` keeps the report, the severity gate below decides.
                            # A genuine scanner failure leaves no report, which the gate rejects ("cannot read report").
                            docker run --rm --user "$(id -u):$(id -g)" ${MOUNT_FLAG} -w "${WORKSPACE}" "${OSV_IMAGE}" \
                                scan source --lockfile=apps/mobile/pubspec.lock --format=json --output-file=apps/mobile/build/reports/osv-scanner-report.json || true
                            echo "✅ osv-scanner analysis completed."

                            # Severity gate (parity with backend DP-402): fails on critical/high, or on a missing/unparseable report
                            node scripts/cicd/osv-gate.js apps/mobile/build/reports/osv-scanner-report.json
                        '''
                    }
                }
            }
        }

        // ----------------------------------------------------------------------
        // DP-603 & DP-605: Fastlane Release APK Build & Keystore Signing (main branch only)
        // ----------------------------------------------------------------------
        stage('DP-605: Build & Sign Release APK') {
            when {
                anyOf {
                    branch 'main'
                    expression {
                        return env.GIT_BRANCH == 'main' || env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main'
                    }
                }
            }
            steps {
                echo "==> [${env.APP_NAME}] Building signed Release APK via Flutter (arm64 targeted for speed)..."
                sh '''
                    rm -rf apps/mobile/build/app/outputs/flutter-apk
                    mkdir -p apps/mobile/build/reports

                    # Optimized release APK build: targeting android-arm64 cuts build time by >60%
                    bash scripts/cicd/flutter-docker.sh "flutter build apk --release --target-platform android-arm64 --build-name=${VERSION_NAME} --build-number=${BUILD_NUMBER:-1}"

                    # Normalize APK output filename
                    if [ -f "apps/mobile/build/app/outputs/flutter-apk/app-arm64-v8a-release.apk" ] && [ ! -f "apps/mobile/build/app/outputs/flutter-apk/app-release.apk" ]; then
                        cp apps/mobile/build/app/outputs/flutter-apk/app-arm64-v8a-release.apk apps/mobile/build/app/outputs/flutter-apk/app-release.apk
                    fi

                    APK_PATH="apps/mobile/build/app/outputs/flutter-apk/app-release.apk"
                    test -s "$APK_PATH"
                    ls -lh "$APK_PATH"

                    # DP-603: Independent proof of cryptographic signature
                    echo "==> Verifying APK code signature certificate..."
                    keytool -printcert -jarfile "$APK_PATH" | tee apps/mobile/build/apk-signer.txt || true
                '''
            }
        }

        // ----------------------------------------------------------------------
        // DP-602: MobSF Mobile Binary Static Security Analysis (main branch only)
        // ----------------------------------------------------------------------
        stage('DP-602: MobSF Static Security Analysis') {
            when {
                anyOf {
                    branch 'main'
                    expression {
                        return env.GIT_BRANCH == 'main' || env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main'
                    }
                }
            }
            steps {
                echo "==> [${env.APP_NAME}] Performing MobSF static security scan on Release APK..."
                sh '''
                    chmod +x scripts/cicd/mobsf-scan.sh || true
                    bash scripts/cicd/mobsf-scan.sh apps/mobile/build/app/outputs/flutter-apk/app-release.apk
                '''
            }
        }

        // ----------------------------------------------------------------------
        // DP-605: Direct APK Distribution & In-App Update Manifest (main branch only)
        // ----------------------------------------------------------------------
        stage('DP-605: Azure Blob Release & In-App Update Manifest') {
            when {
                anyOf {
                    branch 'main'
                    expression {
                        return env.GIT_BRANCH == 'main' || env.GIT_BRANCH == 'origin/main' || env.BRANCH_NAME == 'main'
                    }
                }
            }
            steps {
                echo "==> [${env.APP_NAME}] Preparing In-App Update version manifest and Azure Blob release..."
                sh '''
                    # Generate version.json for In-App Version Checker & Force Update
                    cat <<EOF > apps/mobile/build/version.json
{
  "latest_version": "${VERSION_NAME}",
  "latest_build_number": ${BUILD_NUMBER:-1},
  "min_required_version": "${MIN_REQUIRED_VERSION:-1.0.0}",
  "min_required_build_number": ${MIN_REQUIRED_BUILD_NUMBER:-1},
  "download_url": "https://${AZURE_STORAGE_ACCOUNT}.blob.core.windows.net/${AZURE_STORAGE_CONTAINER}/app-release-v${VERSION_NAME}.apk",
  "release_notes": "Automated release build #${BUILD_NUMBER:-1} with routine improvements",
  "force_update": false
}
EOF
                    cat apps/mobile/build/version.json

                    # Upload to Microsoft Azure Blob Storage if credentials are configured (Rule 8)
                    if [ -n "${AZURE_STORAGE_KEY:-}" ] || [ -n "${AZURE_STORAGE_SAS_TOKEN:-}" ]; then
                        echo "==> Uploading artifacts to Azure Blob Storage..."
                        AUTH_FLAG="${AZURE_STORAGE_KEY:+--account-key ${AZURE_STORAGE_KEY}}"
                        AUTH_FLAG="${AUTH_FLAG:-${AZURE_STORAGE_SAS_TOKEN:+--sas-token ${AZURE_STORAGE_SAS_TOKEN}}}"
                        
                        az storage blob upload --account-name "${AZURE_STORAGE_ACCOUNT}" --container-name "${AZURE_STORAGE_CONTAINER}" \
                            --name "app-release-v${VERSION_NAME}.apk" --file apps/mobile/build/app/outputs/flutter-apk/app-release.apk --overwrite ${AUTH_FLAG}
                        az storage blob upload --account-name "${AZURE_STORAGE_ACCOUNT}" --container-name "${AZURE_STORAGE_CONTAINER}" \
                            --name "app-release.apk" --file apps/mobile/build/app/outputs/flutter-apk/app-release.apk --overwrite ${AUTH_FLAG}
                        az storage blob upload --account-name "${AZURE_STORAGE_ACCOUNT}" --container-name "${AZURE_STORAGE_CONTAINER}" \
                            --name "version.json" --file apps/mobile/build/version.json --overwrite ${AUTH_FLAG}
                        echo "✅ Released to Azure Blob Storage successfully."
                    else
                        echo "ℹ️ AZURE_STORAGE_KEY not supplied. Skipping remote cloud upload step (artifacts archived locally in Jenkins)."
                    fi
                '''
            }
        }
    }

    post {
        always {
            // Restore workspace file ownership to host user
            sh 'chown -R "$(stat -c \'%u:%g\' .)" . || true'
            archiveArtifacts artifacts: 'apps/mobile/build/app/outputs/flutter-apk/*.apk,apps/mobile/build/version.json,apps/mobile/build/apk-signer.txt,apps/mobile/build/reports/*.json,apps/mobile/coverage/lcov.info', allowEmptyArchive: true
        }
        success {
            echo "🎉 Mobile CI/CD Pipeline (EPICDP 6: DP-600 to DP-605) completed successfully!"
            sh '''
                echo "📢 [NOTIFICATION - SUCCESS]"
                echo "=========================================="
                echo "Project : ${APP_NAME}"
                echo "Branch  : ${GIT_BRANCH:-main}"
                echo "Build   : #${BUILD_NUMBER}"
                echo "URL     : ${BUILD_URL}"
                echo "Status  : SUCCEEDED ✅"
                echo "=========================================="
                if [ -n "${SLACK_WEBHOOK_URL:-}" ]; then
                    curl -s -X POST -H 'Content-type: application/json' \
                        --data "{\\"text\\":\\"🎉 *[${APP_NAME}]* Build #${BUILD_NUMBER} on *${GIT_BRANCH:-main}* succeeded!\\n<${BUILD_URL}|View Build Details>\\"}" \
                        "${SLACK_WEBHOOK_URL}" || true
                fi
            '''
        }
        failure {
            echo "❌ Mobile CI/CD Pipeline encountered errors."
            sh '''
                echo "📢 [NOTIFICATION - FAILURE]"
                echo "=========================================="
                echo "Project : ${APP_NAME}"
                echo "Branch  : ${GIT_BRANCH:-main}"
                echo "Build   : #${BUILD_NUMBER}"
                echo "URL     : ${BUILD_URL}"
                echo "Status  : FAILED ❌"
                echo "=========================================="
                if [ -n "${SLACK_WEBHOOK_URL:-}" ]; then
                    curl -s -X POST -H 'Content-type: application/json' \
                        --data "{\\"text\\":\\"❌ *[${APP_NAME}]* Mobile Build #${BUILD_NUMBER} on *${GIT_BRANCH:-main}* failed!\\n<${BUILD_URL}|View Build Details>\\"}" \
                        "${SLACK_WEBHOOK_URL}" || true
                fi
            '''
        }
    }
}
