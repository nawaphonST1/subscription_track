# Copy to infra/monitoring/prod-agent/.env ON THE AZURE PRODUCTION VM and fill
# in real values. .env is git-ignored repository-wide — never commit it.

# The Docker network the app stack (docker-compose-prosuction.yml) created, so
# the database and cache exporters can resolve `postgres` and `redis`.
#   docker network ls --filter name=_default
APP_NETWORK=subscription_track_default

# postgres_exporter connection string. Use a dedicated, read-only-ish
# monitoring role — not the application's own user:
#   CREATE USER exporter WITH PASSWORD '<random>';
#   GRANT pg_monitor TO exporter;
# sslmode=disable is correct here and only here: the connection never leaves
# the Docker network on a single host.
DATA_SOURCE_NAME=postgresql://exporter:change-me@postgres:5432/subtracker_db?sslmode=disable

# redis_exporter target. Add the password form only if the app's Redis has one:
#   redis://:<password>@redis:6379
REDIS_ADDR=redis://redis:6379
