# ==============================================================================
# terraform.tfvars.example
# คัดลอกไฟล์นี้เป็น terraform.tfvars เพื่อปรับแต่งค่าตัวแปรตามสภาพแวดล้อมของคุณ
# (หมายเหตุ: terraform.tfvars จะถูก .gitignore ไว้ เพื่อไม่ให้รหัสผ่านหรือข้อมูลส่วนตัวหลุด)
# ==============================================================================

# --- Azure General Configuration ---
resource_group_name = "rg-subtracker-prod"
location            = "southeastasia" # สิงคโปร์
environment         = "production"

# --- DP-200: Network Configuration ---
vnet_address_space    = ["10.0.0.0/16"]
subnet_address_prefix = ["10.0.1.0/24"]

# --- DP-201: Production Compute VM (Primary Setup) ---
vm_size        = "Standard_B2s" # 2 vCPU, 4 GiB RAM
os_disk_size_gb = 64
admin_username = "azureuser"

# กำหนด SSH Public Key สำหรับล็อกอิน (แนะนำสำหรับความปลอดภัย)
# เช่น: ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC..."
# หากปล่อยว่างไว้ จะใช้รหัสผ่าน admin_password แทน
ssh_public_key = ""
admin_password = "SubTrackerProd2026!#"

# --- DP-201: Optional Managed Kubernetes Cluster (AKS) ---
# ตั้งเป็น true หากต้องการสร้าง Azure Kubernetes Service (AKS) สำหรับตรวจงาน Managed K8s
# (ตั้งเป็น false เป็นค่าเริ่มต้น เพื่อประหยัดงบและโควตาเครดิต Azure)
enable_aks_cluster = false
aks_node_count     = 1
aks_vm_size        = "Standard_B2s"
