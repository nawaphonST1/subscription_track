# ==============================================================================
# Production environment contract for the Docker Compose deployment
# ==============================================================================
# Copy to apps/server/.env.production and fill in real values:
#   cp apps/server/.env.production.example apps/server/.env.production
#
# .env.production is gitignored and must never be committed. It is loaded via
# `env_file:` by docker-compose-prosuction.yml and
# apps/server/docker-compose-prosuction.yml.
#
# Every value below is a placeholder. REPLACE_ME will not authenticate against
# anything — the stack is meant to fail loudly rather than come up on a
# default credential. See doc/security/secrets-management.md.
#
# Variables already supplied by the compose files (NODE_ENV, APP_HOST, PORT,
# DB_HOST, DB_PORT, REDIS_HOST, REDIS_PORT) are intentionally not repeated here.
# ==============================================================================

# --- Postgres container initialisation (service: postgres) --------------------
POSTGRES_DB=REPLACE_ME
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# --- API database connection (service: api) -----------------------------------
# These must agree with the POSTGRES_* values above; the API and the database
# container read the same credentials under two different names.
DB_NAME=REPLACE_ME
DB_USER=REPLACE_ME
DB_PASSWORD=REPLACE_ME

# --- Prisma connection string (services: api, worker, migrate) ----------------
# postgresql://<DB_USER>:<DB_PASSWORD>@postgres:5432/<DB_NAME>?schema=public
# Percent-encode the password if it contains characters outside A-Z a-z 0-9 . _ ~ -
DATABASE_URL=postgresql://REPLACE_ME:REPLACE_ME@postgres:5432/REPLACE_ME?schema=public

# --- Authentication (service: api) --------------------------------------------
# Minimum 32 characters from a CSPRNG. Generate with:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_ME

# --- Worker push delivery (service: worker) -----------------------------------
# 'stub' never contacts a real push service. Set 'fcm' only together with
# FCM_SERVICE_ACCOUNT_JSON — there is no silent fallback to fcm.
PUSH_PROVIDER=stub

# Required only when PUSH_PROVIDER=fcm. Full Firebase service-account JSON as a
# single line. Leave empty for 'stub'.
FCM_SERVICE_ACCOUNT_JSON=

# --- Error tracking (DP-503, optional; services: api, worker) -----------------
# Empty or absent = Sentry off and the SDK never loaded. To turn it on, install
# the optional package first (apps/server/docs/sentry.md) — a DSN without the
# package logs a warning and leaves tracking off rather than failing to start.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=
