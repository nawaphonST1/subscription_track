# ==============================================================================
# Subscription Track — Mobile Environment Configuration Schema (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Pass to flutter run / build with:
#   flutter run --dart-define-from-file=.env
# ==============================================================================

# Backend API Base URL
# For local physical device, replace localhost with your machine's LAN IP (e.g. http://192.168.1.50:3000)
# For Android emulator: http://10.0.2.2:3000
API_BASE_URL=http://localhost:3000

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=599940750728-bh01euq9q5unhnvlnai02sjlj18km8tm.apps.googleusercontent.com
