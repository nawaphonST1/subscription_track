# ==============================================================================
# Subscription Track — Centralized Environment Configuration Schema (.env.example)
# ==============================================================================
# Copy this file to .env before starting local services.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_HOST=0.0.0.0
PORT=8080

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# When API runs on host: DB_HOST=localhost
# Inside Docker Compose:  DB_HOST=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subtracker_db
DB_USER=postgres
DB_PASSWORD=change-me
# Optional full connection URL (overrides separate DB_* parameters if supplied):
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/subtracker_db?schema=public

# ------------------------------------------------------------------------------
# 3. Redis Cache & Queue Connection
# ------------------------------------------------------------------------------
# When API runs on host: REDIS_HOST=localhost
# Inside Docker Compose:  REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Worker & Notification Service
# ------------------------------------------------------------------------------
PUSH_PROVIDER=stub
FCM_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 5. Authentication & Security
# ------------------------------------------------------------------------------
# Production JWT secrets must be generated using a CSPRNG with >= 256 bits of entropy (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-chars

# ------------------------------------------------------------------------------
# 6. Agent & Governance Configuration
# ------------------------------------------------------------------------------
AGENT_RULES_FILE=agent.md

# ------------------------------------------------------------------------------
# 7. Error tracking (DP-503, optional)
# ------------------------------------------------------------------------------
# Leave SENTRY_DSN empty and Sentry stays off: the SDK is never even loaded.
# Setting it also requires the optional package to be installed —
# `pnpm --filter server add @sentry/nestjs` — see apps/server/docs/sentry.md.
# The DSN is a write-only ingestion key, not a login, but it still does not
# belong in git.
SENTRY_DSN=
# 0 = no performance traces (default). Prometheus already measures latency.
SENTRY_TRACES_SAMPLE_RATE=0
# Optional: ties an event to a build, e.g. the git sha.
# SENTRY_RELEASE=
