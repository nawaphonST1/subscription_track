# Copy to infra/security/wazuh/.env on the developer workstation and fill in.
# .env is git-ignored repository-wide — never commit it.
#
# Generate each value with: openssl rand -base64 24
# The indexer rejects weak passwords, and these are NOT the upstream demo
# defaults on purpose: wazuh-docker ships SecretPassword / kibanaserver /
# MyS3cr37P450r.*- in its compose file, and those are public knowledge.

# This host's Tailscale address (tailscale ip -4). The agent on the Azure VM
# connects here and only here; 1514/1515 are never bound to 0.0.0.0.
# 100.64.0.1 is an RFC 6598 (Tailscale/CGNAT) placeholder that allows
# 'docker compose config -q' to pass syntax validation before deployment.
WAZUH_BIND_ADDR=100.64.0.1

# OpenSearch `admin` user, used by the manager and the dashboard.
WAZUH_INDEXER_PASSWORD=change-me

# Wazuh API user `wazuh-wui`.
WAZUH_API_PASSWORD=change-me

# Dashboard's own indexer user `kibanaserver`.
WAZUH_DASHBOARD_PASSWORD=change-me

# Password agents present when enrolling (scripts/wazuh-agent-bootstrap.sh).
# Written into the manager's authd config — see README §4.
WAZUH_REGISTRATION_PASSWORD=change-me
