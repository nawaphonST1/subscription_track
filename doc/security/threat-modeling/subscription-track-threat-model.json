                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Direct port 5432 exposure allowing brute force or data exfiltration.",
                  "mitigation": "Placed strictly inside Private Subnet without public IP; protected by Azure NSG and K8s NetworkPolicies allowing only API/Worker access."
                },
                {
                  "title": "Data Loss from Server Crash or Corruption",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Hardware failure destroys subscription data.",
                  "mitigation": "Persistent Volume Claims (PVC) backed by managed cloud disks and automated daily backup cronjob synced offsite."
                }
