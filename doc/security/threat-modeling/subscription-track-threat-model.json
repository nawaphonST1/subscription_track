                  "title": "DDoS and API Flooding Attacks",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Attackers send voluminous requests to exhaust backend memory and CPU.",
                  "mitigation": "Traefik RateLimiting middleware (DP-303) and K8s ResourceQuotas (DP-202)."
                },
                {
                  "title": "Man-in-the-Middle (MitM) Eavesdropping",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Interception of credentials and payload between client and server.",
                  "mitigation": "Strict TLS 1.3 encryption with automated Let's Encrypt certificates managed by Traefik ACME (DP-301)."
                },
                {
                  "title": "Bad Bot and Vulnerability Scanning",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "Automated scanners probing for open endpoints and zero-day vulnerabilities.",
                  "mitigation": "Traefik Bad-bot filtering and Security Headers middleware (X-Content-Type-Options, HSTS, CSP)."
                }
              ],
              "attrs": {
                ".element-shape": {
                  "class": "element-shape isInScope"
