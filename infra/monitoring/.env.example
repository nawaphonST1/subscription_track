# Copy to infra/monitoring/.env on the monitoring VM and fill in real values.
# .env is git-ignored (both here and in the repository root) — never commit it.

# Grafana admin login (user: admin). Use a long random value, e.g.
#   openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me-use-a-long-random-password

# Public IP or DNS name of the Azure production VM. Only used by the phase-3
# `tunnel` service; a placeholder is fine until then.
AZURE_HOST=change-me-azure-public-ip-or-dns-name
