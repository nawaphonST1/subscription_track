              "threats": [
                {
                  "title": "Mobile Device Theft or Unauthorized Access",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "An attacker with physical access to the device attempts to perform sensitive actions (change subscription, view billing).",
                  "mitigation": "6-digit Security PIN verification step-up required before critical actions (PinVerificationDialog + X-PIN-Verification header)."
                },
                {
                  "title": "Token Extraction from Client Storage",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Malicious apps or compromised device accessing cached JWT tokens.",
                  "mitigation": "Store tokens exclusively in OS-level hardware-backed secure storage (Flutter Secure Storage / Keychain / KeyStore). Short-lived access tokens (15m)."
                }
              ],
              "attrs": {
                ".element-shape": {
