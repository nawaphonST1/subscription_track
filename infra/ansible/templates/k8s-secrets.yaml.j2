# ==============================================================================
# Jinja2 Template: Kubernetes Secrets Rendered from Ansible Vault
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  labels:
    app: postgres
type: Opaque
stringData:
  POSTGRES_DB: "{{ vault_postgres_db }}"
  POSTGRES_USER: "{{ vault_postgres_user }}"
  POSTGRES_PASSWORD: "{{ vault_postgres_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  labels:
    app: taskflow
type: Opaque
stringData:
  JWT_SECRET: "{{ vault_jwt_secret }}"
  DB_PASSWORD: "{{ vault_postgres_password }}"
  DATABASE_URL: "postgresql://{{ vault_postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ vault_postgres_db }}?schema=public"
  {% if vault_redis_password %}
  REDIS_PASSWORD: "{{ vault_redis_password }}"
  {% endif %}
---
apiVersion: v1
kind: Secret
metadata:
  name: backup-azure-secret
  labels:
    app: postgres-backup
type: Opaque
stringData:
  AZURE_STORAGE_ACCOUNT: "{{ vault_azure_storage_account }}"
  AZURE_STORAGE_CONTAINER: "{{ vault_azure_storage_container }}"
  AZURE_STORAGE_KEY: "{{ vault_azure_storage_key }}"
  {% if vault_azure_storage_sas_token %}
  AZURE_STORAGE_SAS_TOKEN: "{{ vault_azure_storage_sas_token }}"
  {% endif %}

