              "hasOpenThreats": false,
              "threats": [
                {
                  "title": "Broken Object Level Authorization (BOLA / IDOR)",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "User A modifies or deletes Subscription owned by User B by altering subscriptionId.",
                  "mitigation": "Enforce CurrentUser ownership checks in Repository/Service layer (BE-206) with 404 concealment on unauthorized access."
                },
                {
                  "title": "JWT Token Forgery or Tampering",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Attacker crafts or modifies JWT claims to impersonate admin or another user.",
                  "mitigation": "Cryptographic signature validation using secure JWT_SECRET (managed via Ansible Vault), strict expiration, and token rotation."
                },
                {
                  "title": "SQL and NoSQL Injection",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Attacker inserts malicious SQL syntax into user profile or subscription parameters.",
                  "mitigation": "TypeORM / Prisma parameterized queries and strict class-validator DTO input validation pipelines."
                }
              ],
