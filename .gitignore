# ==========================================
# Full-Stack Monorepo Git Ignore Rules
# ==========================================

# Operating System & Editors
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE Configuration
*.iml
*.ipr
*.iws
.idea/
#.vscode/

# Private & Secrets
**/.private/
.agents/skills.json
*.env
*.env.local
*.env.*.local
!.env.example

# ==========================================
# Frontend: Flutter & Dart (apps/mobile/)
# ==========================================
**/doc/api/
**/ios/Flutter/.last_build_id
**/.dart_tool/
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/.fvm/flutter_sdk
**/devtools_options.yaml

# Generated plugin registrants
**/generated_plugin_registrant.*
**/generated_plugins.cmake
**/GeneratedPluginRegistrant.swift

# Symbolication & Obfuscation
*.symbols
*.map.json

# Android Studio / Gradle outputs
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/.gradle/

# ==========================================
# Backend: NestJS & Node.js (apps/api/)
# ==========================================
**/node_modules/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==========================================
# Infrastructure & Local Volumes (infra/)
# ==========================================
infra/postgres/data/
infra/redis/data/
