# Fastlane configuration for Subscription Track Android App
# Automates APK compilation, code signing verification, and Azure Blob Storage distribution

default_platform(:android)

platform :android do
  desc "Pre-run sanity checks"
  before_all do
    ENV["FASTLANE_XCODE_LIST_TIMEOUT"] = "120"
  end

  desc "DP-605: Build signed release APK with Flutter"
  lane :build_apk do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"] || "1.0.0"
    build_number = options[:build_number] || ENV["BUILD_NUMBER"] || "1"

    UI.message("🚀 Building signed Release APK (Version: #{version_name}, Build: #{build_number})...")

    # Run flutter build apk in mobile directory
    sh("flutter build apk --release --build-name=#{version_name} --build-number=#{build_number}")

    apk_path = "../../build/app/outputs/flutter-apk/app-release.apk"
    UI.user_error!("❌ Release APK was not found at #{apk_path}") unless File.exist?(apk_path)
    UI.success("✅ Release APK generated successfully at: #{apk_path}")
  end

  desc "DP-603 / DP-605: Verify Release APK code signature"
  lane :verify_signature do
    apk_path = "../../build/app/outputs/flutter-apk/app-release.apk"
    UI.user_error!("❌ Release APK not found for signature verification") unless File.exist?(apk_path)

    UI.message("🔍 Verifying APK signature certificates...")
    sh("keytool -printcert -jarfile #{apk_path} | tee ../../build/apk-signer.txt")
    UI.success("✅ APK signature verified successfully.")
  end

  desc "DP-605: Generate version.json manifest and release to Azure Blob Storage"
  lane :release_apk_azure do |options|
    version_name = options[:version_name] || ENV["VERSION_NAME"] || "1.0.0"
    build_number = (options[:build_number] || ENV["BUILD_NUMBER"] || "1").to_i
    storage_account = options[:storage_account] || ENV["AZURE_STORAGE_ACCOUNT"] || "subtrackerreleases"
    storage_container = options[:storage_container] || ENV["AZURE_STORAGE_CONTAINER"] || "releases"
    release_notes = options[:release_notes] || ENV["RELEASE_NOTES"] || "Routine security and performance improvements"
    force_update = (ENV["FORCE_UPDATE"] == "true" || options[:force_update] == true)

    apk_src = "../../build/app/outputs/flutter-apk/app-release.apk"
    target_apk_name = "subscription-track-v#{version_name}.apk"
    latest_apk_name = "app-release.apk"

    # 1. Generate version.json for In-App Version Checker & Force Update
    download_url = "https://#{storage_account}.blob.core.windows.net/#{storage_container}/#{latest_apk_name}"
    manifest = {
      latest_version: version_name,
      latest_build_number: build_number,
      min_required_version: ENV["MIN_REQUIRED_VERSION"] || "1.0.0",
      min_required_build_number: (ENV["MIN_REQUIRED_BUILD_NUMBER"] || "1").to_i,
      download_url: download_url,
      release_notes: release_notes,
      force_update: force_update
    }

    manifest_path = "../../build/version.json"
    File.write(manifest_path, JSON.pretty_generate(manifest))
    UI.message("📄 Generated In-App Update manifest at #{manifest_path}:")
    UI.message(File.read(manifest_path))

    # 2. Upload to Azure Blob Storage (Rule 8 Mandate)
    if ENV["AZURE_STORAGE_KEY"] || ENV["AZURE_STORAGE_SAS_TOKEN"]
      UI.message("☁️ Uploading APK and version.json to Azure Blob Storage container '#{storage_container}'...")
      auth_arg = ENV["AZURE_STORAGE_KEY"] ? "--account-key #{ENV['AZURE_STORAGE_KEY']}" : "--sas-token '#{ENV['AZURE_STORAGE_SAS_TOKEN']}'"
      
      sh("az storage blob upload --account-name #{storage_account} --container-name #{storage_container} --name #{target_apk_name} --file #{apk_src} --overwrite #{auth_arg}")
      sh("az storage blob upload --account-name #{storage_account} --container-name #{storage_container} --name #{latest_apk_name} --file #{apk_src} --overwrite #{auth_arg}")
      sh("az storage blob upload --account-name #{storage_account} --container-name #{storage_container} --name version.json --file #{manifest_path} --overwrite #{auth_arg}")
      UI.success("🎉 Successfully deployed to Azure Blob Storage: #{download_url}")
    else
      UI.important("⚠️ Azure credentials not set in current environment. APK and manifest prepared locally in build/")
    end
  end

  desc "DP-604 (Legacy reference): Build App Bundle for Google Play Store"
  lane :deploy_playstore do
    UI.important("ℹ️ Note: Project distribution pivoted from Play Store to Direct APK & Azure Blob Storage.")
    sh("flutter build appbundle --release")
  end
end
