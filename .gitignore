# ==========================================
# Full-Stack Monorepo Git Ignore Rules
# ==========================================

# Operating System & Editors
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE Configuration
*.iml
*.ipr
*.iws
.idea/
#.vscode/

# Private & Secrets
**/.private/
agent.md
agents.md
AGENTS.md
**/vault.yml
.agents/
.agents/skills.json
.env
.env.*
.env *
**/.env
**/.env.*
**/.env *
!.env.example
!**/.env.example
!**/.env.*.example

# ==========================================
# Frontend: Flutter & Dart (apps/mobile/)
# ==========================================
**/doc/api/
**/ios/Flutter/.last_build_id
**/.dart_tool/
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/.fvm/flutter_sdk
**/devtools_options.yaml

# Generated plugin registrants
**/generated_plugin_registrant.*
**/generated_plugins.cmake
**/GeneratedPluginRegistrant.swift

# Symbolication & Obfuscation
*.symbols
*.map.json

# Android Studio / Gradle outputs
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/.gradle/

# ==========================================
# Backend: NestJS & Node.js (apps/server/)
# ==========================================
**/node_modules/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==========================================
# Infrastructure & Local Volumes (infra/)
# ==========================================
infra/postgres/data/
infra/redis/data/

# prod-agent: temporary diagnostic/rollback files from the 2026-10-07 Alloy
# self-log feedback loop incident — kept locally as an instant rollback
# option, never meant for git history. Remove once config.alloy has been
# stable long enough that these aren't needed. See the fix in config.alloy.
infra/monitoring/prod-agent/*.bak
infra/monitoring/prod-agent/config.metrics-only.alloy
infra/monitoring/prod-agent/docker-compose.metrics-only.override.yml
infra/monitoring/prod-agent/docker-compose.test-traffic.override.yml

# Local CLI Binaries & Cluster Configs
*.exe
scripts/bin/
*.jks
kubeconfig.txt

# Secrets & Vault Passwords
.vault_pass
*.key

# Cluster Secrets are created out-of-band, never committed: ArgoCD syncs
# k8s/ with prune+selfHeal, so a Secret here would be reconciled onto the
# cluster, value and all. Use scripts/bootstrap-secrets.sh.
# See doc/security/secrets-management.md
k8s/postgres-secret.yaml
k8s/secrets.yaml

# Terraform Local Cache & State
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Terraform variable files may contain sensitive values; only the .example is tracked
*.tfvars
!*.tfvars.example

# Test Artifacts & Coverage Reports
**/playwright-report/
**/test-results/
**/reports/

# Cache directories & scanner databases
.cache/
**/.cache/

# Monitoring stack secrets: SSH private key + verified known_hosts for the
# reverse tunnel to the production VM. Created by hand on the monitoring VM.
infra/monitoring/secrets/

**/doc/
docs/
**/docs/

# Wazuh: โฟลเดอร์ที่เผลอ cp มาไว้ผิดที่ (ของจริงอยู่ที่ infra/security/wazuh/ ซึ่งมี
# .gitignore ของตัวเองคุมอยู่แล้ว) ขีดนำหน้าคือ "เฉพาะระดับ root เท่านั้น"
/config/
/upstream/
